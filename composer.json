{
    "name": "tushar-arote/rediscope",
    "description": "An Laravel Telescope like UI for Z-Song RedisManager",
    "license": "MIT",
    "authors": [
        {
            "name": "Tushar Arote",
            "email": "tushararote123@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0",
        "moontoast/math": "^1.1",
        "predis/predis": "^2.0",
        "symfony/var-dumper": "^6.0|^7.0"
    },
    "require-dev": {
        "ext-gd": "*",
        "orchestra/testbench": "^7.0|^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Rediscope\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rediscope\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rediscope\\RediscopeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
